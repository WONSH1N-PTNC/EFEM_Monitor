# Visual Studio 캐시 / 사용자 설정
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# 빌드 산출물
bin/
obj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
*.dll
*.pdb
*.cache

# NuGet
packages/
*.nupkg
!**/packages/build/

# 테스트 결과
[Tt]est[Rr]esult*/
*.trx
*.coverage

# docs 폴더는 .md 문서만 추적한다.
# 협력사(DSE) 원본 자료(xlsx/pdf)는 CONFIDENTIAL 표기가 있어 저장소에 올리지 않는다.
# git 히스토리는 한번 푸시하면 제거가 어려우므로 애초에 커밋하지 않는다.
docs/**
!docs/**/
!docs/**/*.md

# 운영 데이터 (로컬 실행 시 생성)
log/*.db
log/*.db-wal
log/*.db-shm
log/*.csv

# OS
Thumbs.db
.DS_Store
