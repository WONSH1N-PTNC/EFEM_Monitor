    {
      "code": "AL-66",
      "name": "PC Temp Error",
      "severity": "Alarm",
      "source": "host:cpuTemperature",
      "condition": "GreaterThan",
      "threshold": 75.0,
      "debounceMs": 30000,
      "resetPolicy": "Auto",
      "enabled": false,
      "messageKo": "제어 PC 온도 상승 — 온도 취득 경로 미구현"
    },

    // ══ DG : 사내 진단 알람 ════════════════════════════════════════════════════
    //
    // 고객 사양(Alarm LIST 66종)에 없는 항목이다. 66종은 "고장이 났다" 를 알리고,
    // 이쪽은 "고장 나기 전" 을 알린다. 밸브가 다 열렸는데도 목표에 못 미치는 상태를
    // 알아야 배기 계통 막힘을 조기에 잡을 수 있다.
    //
    // 상위(GEM)에는 보고하지 않는다. gem-map.json 의 ALID 는 AL-** 만 매핑한다.

    {
      "code": "DG-01",
      "name": "Pressure Sensor Group Communication Failure",
      "severity": "Critical",
      "source": "deviceGroup:Pressure",
      "condition": "CommFail",
      "debounceMs": 1000,
      "resetPolicy": "Auto",
      "messageKo": "압력센서 통신 실패 — 제어 기준값을 신뢰할 수 없음"
    },
    {
      // 밸브가 전개도인데 목표에 못 미치면 배기 계통에 저항이 생긴 것이다.
      // 이 시점에 알려야 압력 이탈(AL-46~AL-55)로 번지기 전에 손을 쓸 수 있다.
      "code": "DG-02",
      "name": "Throttle Valve Saturated",
      "severity": "Warning",
      "source": "device:V-1.positionPercent",
      "condition": "GreaterThan",
      "threshold": 98.0,
      "debounceMs": 30000,
      "resetPolicy": "Auto",
      "messageKo": "중앙 스로틀밸브 개도 포화 — 배기 계통 저항 확인"
    },
    {
      // 밸브 포화 후 팬까지 최대면 더 올릴 여지가 없다. 제어 한계 도달이다.
      "code": "DG-03",
      "name": "Blower RPM Saturated",
      "severity": "Warning",
      "source": "device:F-1.rpm",
      "condition": "GreaterThan",
      "threshold": 3900.0,
      "debounceMs": 30000,
      "resetPolicy": "Auto",
      "messageKo": "중앙 블로워 회전수 포화 — 제어 여유 없음"
    },
    {
      // ★ IL-01 은 0 Pa 에서 정지시킨다. 그 전에 알려 주는 것이 이 규칙이다.
      // -100 Pa 를 넘어서면 배기 음압이 절반 이상 사라진 상태다.
      "code": "DG-04",
      "name": "Exhaust Negative Pressure Degraded",
      "severity": "Warning",
      "source": "device:S3-1.pressurePa",
      "condition": "GreaterThan",
      "threshold": -100.0,

      // ★ 레시피와 무관한 고정 기준이다. 인터록(0 Pa) 도달 전에 알리는 것이 목적이므로
      // 레시피의 하한을 따라 움직이면 안 된다. 값 중복 경고를 의도적으로 면제한다.
      "independentThreshold": true,
      "debounceMs": 10000,
      "resetPolicy": "Auto",
      "messageKo": "배기 음압 저하 — 인터록(0 Pa) 도달 전 경고"
    },
    {
      "code": "DG-05",
      "name": "EFEM Temperature High",
      "severity": "Warning",
      "source": "aux:temperatureEfem",
      "condition": "GreaterThan",
      "threshold": 30.0,
      "debounceMs": 60000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 내부 온도 상승"
    },
