    // ── AL-32 ~ AL-36 : 블로워 냉각팬 정지 ────────────────────────────────────
    // PLC 디지털 입력. 극성 미확정이므로 device-map 의 activeHigh 로 조정한다.
    {
      "code": "AL-32",
      "name": "EFEM Center Blower Motor Cooling Fan Stop",
      "severity": "Alarm",
      "source": "plc:di.fanStop[0]",
      "condition": "BitSet",
      "debounceMs": 3000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 중앙 블로워 냉각팬 정지"
    },
    {
      "code": "AL-33",
      "name": "EFEM Center Left Blower Motor Cooling Fan Stop",
      "severity": "Alarm",
      "source": "plc:di.fanStop[1]",
      "condition": "BitSet",
      "debounceMs": 3000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 좌측 블로워 냉각팬 정지"
    },
    {
      "code": "AL-34",
      "name": "EFEM Center Right Blower Motor Cooling Fan Stop",
      "severity": "Alarm",
      "source": "plc:di.fanStop[2]",
      "condition": "BitSet",
      "debounceMs": 3000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 우측 블로워 냉각팬 정지"
    },
    {
      "code": "AL-35",
      "name": "EFEM Side Storage Left Blower Motor Cooling Fan Stop",
      "severity": "Alarm",
      "source": "plc:di.fanStop[3]",
      "condition": "BitSet",
      "debounceMs": 3000,
      "resetPolicy": "Auto",
      "messageKo": "보관부 좌측 블로워 냉각팬 정지"
    },
    {
      "code": "AL-36",
      "name": "EFEM Side Storage Right Blower Motor Cooling Fan Stop",
      "severity": "Alarm",
      "source": "plc:di.fanStop[4]",
      "condition": "BitSet",
      "debounceMs": 3000,
      "resetPolicy": "Auto",
      "messageKo": "보관부 우측 블로워 냉각팬 정지"
    },

    // ── AL-37 ~ AL-39 : 안전 입력 / 제어함 ────────────────────────────────────
    // EMO 는 인터록 IL-02 가 액추에이터를 세우고, 이 알람은 기록·통보를 맡는다.
    // 디바운스 0 인 이유는 비상정지를 지연 없이 남겨야 하기 때문이다.
    {
      "code": "AL-37",
      "name": "Emergency Stop",
      "severity": "Critical",
      "source": "plc:di.emo",
      "condition": "BitSet",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "messageKo": "비상정지 작동"
    },
    {
      "code": "AL-38",
      "name": "Control BOX Fan Top Stop",
      "severity": "Alarm",
      "source": "plc:di.ctrlBoxFanTop",
      "condition": "BitSet",
      "debounceMs": 3000,
      "resetPolicy": "Auto",
      "messageKo": "제어함 상부 팬 정지"
    },
    {
      "code": "AL-39",
      "name": "Control BOX Fan Bottom Stop",
      "severity": "Alarm",
      "source": "plc:di.ctrlBoxFanBottom",
      "condition": "BitSet",
      "debounceMs": 3000,
      "resetPolicy": "Auto",
      "messageKo": "제어함 하부 팬 정지"
    },

    // ── AL-40 ~ AL-65 : 압력센서 13대 × 상한/하한 ─────────────────────────────
    // ★ threshold 가 없다. AboveHighLimit / BelowLowLimit 가 source 의 디바이스 ID 로
    // recipe.json 을 조회한다. 값을 여기 복사해 두면 Config 화면에서 설정을 바꿨을 때
    // 알람만 옛 값으로 남아, 화면과 알람이 서로 다른 진실을 말하게 된다.
    //
    // 심각도는 계통별로 다르다.
    //   Sensor1(EFEM 내부) — 청정도 영향. Warning
    //   Sensor2(배기 전면) — 제어 기준. Alarm
    //   Sensor3(배기 하부) — 배기 상실과 직결. Alarm (IL-01 이 별도로 정지시킨다)
    {
      "code": "AL-40",
      "name": "EFEM Center Pressure Sensor High Limit",
      "severity": "Warning",
      "source": "device:S1-1.pressurePa",
      "condition": "AboveHighLimit",
      "debounceMs": 120000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 중앙 압력 상한 초과"
    },
    {
      "code": "AL-41",
      "name": "EFEM Center Pressure Sensor Low Limit",
      "severity": "Warning",
      "source": "device:S1-1.pressurePa",
      "condition": "BelowLowLimit",
      "debounceMs": 120000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 중앙 압력 하한 미달"
    },
    {
      "code": "AL-42",
      "name": "EFEM Side Storage Left Pressure Sensor High Limit",
      "severity": "Warning",
      "source": "device:S1-2.pressurePa",
      "condition": "AboveHighLimit",
      "debounceMs": 120000,
      "resetPolicy": "Auto",
      "messageKo": "보관부 좌측 압력 상한 초과"
    },
    {
      "code": "AL-43",
      "name": "EFEM Side Storage Left Pressure Sensor Low Limit",
      "severity": "Warning",
      "source": "device:S1-2.pressurePa",
      "condition": "BelowLowLimit",
      "debounceMs": 120000,
      "resetPolicy": "Auto",
      "messageKo": "보관부 좌측 압력 하한 미달"
    },
    {
      "code": "AL-44",
      "name": "EFEM Side Storage Right Pressure Sensor High Limit",
      "severity": "Warning",
      "source": "device:S1-3.pressurePa",
      "condition": "AboveHighLimit",
      "debounceMs": 120000,
      "resetPolicy": "Auto",
      "messageKo": "보관부 우측 압력 상한 초과"
    },
    {
      "code": "AL-45",
      "name": "EFEM Side Storage Right Pressure Sensor Low Limit",
      "severity": "Warning",
      "source": "device:S1-3.pressurePa",
      "condition": "BelowLowLimit",
