{
  // ESAM 알람 규칙
  //
  // 코드 체계
  //   AL-01 ~ AL-66  ESAM_IO List_260806 의 Alarm LIST 시트 No. 와 1:1 대응한다.
  //                  시트 번호를 그대로 코드로 쓰므로 대조에 변환표가 필요 없고,
  //                  GEM ALID 매핑도 같은 번호를 쓸 수 있다.
  //   DG-01 ~        고객 사양에 없는 사내 진단 알람. 조기 경고용이다.
  //                  상위(GEM)에는 보고하지 않는다.
  //
  // 임계값의 출처
  //   압력 13대  →  recipe.json (ECID 마스터). 규칙에 숫자를 두지 않는다.
  //   그 외      →  이 파일의 threshold. ECID 대상이 아니라 상위가 관리하지 않는다.
  //
  // 비활성 규칙은 소스가 없거나 사양이 미확정인 것뿐이다.
  // 동작하는 줄 알았는데 아니었던 상태를 만들지 않기 위해 사유를 messageKo 에 남긴다.

  "schemaVersion": "2.0",
  "rules": [
    // ── AL-01 : 상위 통신 ─────────────────────────────────────────────────────
    // SECS/GEM 통신 모듈이 아직 없다(S7). 소스가 없는 규칙을 활성으로 두면
    // 화면의 알람 목록에는 있는데 영원히 울리지 않는다.
    {
      "code": "AL-01",
      "name": "FDC Communication Error",
      "severity": "Alarm",
      "source": "gem:link",
      "condition": "CommFail",
      "debounceMs": 10000,
      "resetPolicy": "Auto",
      "enabled": false,
      "messageKo": "상위(FDC) 통신 이상 — SECS/GEM 모듈 미구현(S7)"
    },

    // ── AL-02 ~ AL-16 : 스로틀밸브 5대 × 3종 ──────────────────────────────────
    // 모터 이상은 알람코드(0x2203), 통신 이상은 응답 없음으로 판정한다.
    // 홈센서 이상은 알람코드의 어느 비트인지 미확정이라 비활성이다.
    {
      "code": "AL-02",
      "name": "EFEM Center Throttle Valve Motor Error",
      "severity": "Critical",
      "source": "device:V-1.alarmCode",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "messageKo": "EFEM 중앙 스로틀밸브 모터 이상 — 알람코드 확인"
    },
    {
      "code": "AL-03",
      "name": "EFEM Center Throttle Valve Home Sensor Error",
      "severity": "Critical",
      "source": "device:V-1.alarmCode",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "enabled": false,
      "messageKo": "EFEM 중앙 스로틀밸브 홈센서 이상 — 알람코드 0x2203 비트 정의 미확정"
    },
    {
      "code": "AL-04",
      "name": "EFEM Center Throttle Valve Driver Communication Error",
      "severity": "Critical",
      "source": "device:V-1",
      "condition": "CommFail",
      "debounceMs": 1000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 중앙 스로틀밸브 드라이버 통신 이상"
    },
    {
      "code": "AL-05",
      "name": "EFEM Center Left Throttle Valve Motor Error",
      "severity": "Critical",
      "source": "device:V-2.alarmCode",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "messageKo": "EFEM 좌측 스로틀밸브 모터 이상 — 알람코드 확인"
    },
    {
      "code": "AL-06",
      "name": "EFEM Center Left Throttle Valve Home Sensor Error",
      "severity": "Critical",
      "source": "device:V-2.alarmCode",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "enabled": false,
      "messageKo": "EFEM 좌측 스로틀밸브 홈센서 이상 — 알람코드 0x2203 비트 정의 미확정"
    },
    {
      "code": "AL-07",
      "name": "EFEM Center Left Throttle Valve Driver Communication Error",
      "severity": "Critical",
      "source": "device:V-2",
      "condition": "CommFail",
      "debounceMs": 1000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 좌측 스로틀밸브 드라이버 통신 이상"
    },
    {
      "code": "AL-08",
      "name": "EFEM Center Right Throttle Valve Motor Error",
      "severity": "Critical",
      "source": "device:V-3.alarmCode",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "messageKo": "EFEM 우측 스로틀밸브 모터 이상 — 알람코드 확인"
    },
    {
      "code": "AL-09",
      "name": "EFEM Center Right Throttle Valve Home Sensor Error",
      "severity": "Critical",
      "source": "device:V-3.alarmCode",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "enabled": false,
      "messageKo": "EFEM 우측 스로틀밸브 홈센서 이상 — 알람코드 0x2203 비트 정의 미확정"
    },
    {
      "code": "AL-10",
      "name": "EFEM Center Right Throttle Valve Driver Communication Error",
      "severity": "Critical",
      "source": "device:V-3",
      "condition": "CommFail",
      "debounceMs": 1000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 우측 스로틀밸브 드라이버 통신 이상"
    },
    {
      "code": "AL-11",
      "name": "EFEM Side Storage Left Throttle Valve Motor Error",
      "severity": "Critical",
      "source": "device:V-4.alarmCode",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "messageKo": "보관부 좌측 스로틀밸브 모터 이상 — 알람코드 확인"
    },
    {
      "code": "AL-12",
      "name": "EFEM Side Storage Left Throttle Valve Home Sensor Error",
      "severity": "Critical",
      "source": "device:V-4.alarmCode",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "enabled": false,
      "messageKo": "보관부 좌측 스로틀밸브 홈센서 이상 — 알람코드 0x2203 비트 정의 미확정"
    },
    {
      "code": "AL-13",
      "name": "EFEM Side Storage Left Throttle Valve Driver Communication Error",
      "severity": "Critical",
      "source": "device:V-4",
      "condition": "CommFail",
      "debounceMs": 1000,
      "resetPolicy": "Auto",
      "messageKo": "보관부 좌측 스로틀밸브 드라이버 통신 이상"
    },
    {
      "code": "AL-14",
      "name": "EFEM Side Storage Right Throttle Valve Motor Error",
      "severity": "Critical",
      "source": "device:V-5.alarmCode",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "messageKo": "보관부 우측 스로틀밸브 모터 이상 — 알람코드 확인"
    },
    {
      "code": "AL-15",
      "name": "EFEM Side Storage Right Throttle Valve Home Sensor Error",
      "severity": "Critical",
      "source": "device:V-5.alarmCode",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "enabled": false,
      "messageKo": "보관부 우측 스로틀밸브 홈센서 이상 — 알람코드 0x2203 비트 정의 미확정"
    },
    {
      "code": "AL-16",
      "name": "EFEM Side Storage Right Throttle Valve Driver Communication Error",
      "severity": "Critical",
      "source": "device:V-5",
      "condition": "CommFail",
      "debounceMs": 1000,
      "resetPolicy": "Auto",
      "messageKo": "보관부 우측 스로틀밸브 드라이버 통신 이상"
    },

    // ── AL-17 ~ AL-31 : 블로워 5대 × 3종 ──────────────────────────────────────
    // 모터 온도는 PLC 가 5점(temp.fan.0~4) 읽는다. 임계값은 협의 중이므로
    // 잠정 80 도로 두었다. ECID 항목이 아니라 알람 설정이 직접 갖는다.
    {
      "code": "AL-17",
      "name": "EFEM Center Blower Motor Error",
      "severity": "Critical",
      "source": "device:F-1.alarmCode",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "messageKo": "EFEM 중앙 블로워 모터 이상 — 알람코드 확인"
    },
    {
      "code": "AL-18",
      "name": "EFEM Center Blower Motor Driver Communication Error",
      "severity": "Critical",
      "source": "device:F-1",
      "condition": "CommFail",
      "debounceMs": 1000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 중앙 블로워 드라이버 통신 이상"
    },
    {
      "code": "AL-19",
      "name": "EFEM Center Blower Motor Temp Error",
      "severity": "Alarm",
      "source": "aux:fanTemperature[0]",
      "condition": "GreaterThan",
      "threshold": 80.0,
      "debounceMs": 5000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 중앙 블로워 모터 온도 상승 (잠정 80 도, 협의 중)"
    },
    {
      "code": "AL-20",
      "name": "EFEM Center Left Blower Motor Error",
      "severity": "Critical",
      "source": "device:F-2.alarmCode",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "messageKo": "EFEM 좌측 블로워 모터 이상 — 알람코드 확인"
    },
    {
      "code": "AL-21",
      "name": "EFEM Center Left Blower Motor Driver Communication Error",
      "severity": "Critical",
      "source": "device:F-2",
      "condition": "CommFail",
      "debounceMs": 1000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 좌측 블로워 드라이버 통신 이상"
    },
    {
      "code": "AL-22",
      "name": "EFEM Center Left Blower Motor Temp Error",
      "severity": "Alarm",
      "source": "aux:fanTemperature[1]",
      "condition": "GreaterThan",
      "threshold": 80.0,
      "debounceMs": 5000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 좌측 블로워 모터 온도 상승 (잠정 80 도, 협의 중)"
    },
    {
      "code": "AL-23",
      "name": "EFEM Center Right Blower Motor Error",
      "severity": "Critical",
      "source": "device:F-3.alarmCode",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "messageKo": "EFEM 우측 블로워 모터 이상 — 알람코드 확인"
    },
    {
      "code": "AL-24",
      "name": "EFEM Center Right Blower Motor Driver Communication Error",
      "severity": "Critical",
      "source": "device:F-3",
      "condition": "CommFail",
      "debounceMs": 1000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 우측 블로워 드라이버 통신 이상"
    },
    {
      "code": "AL-25",
      "name": "EFEM Center Right Blower Motor Temp Error",
      "severity": "Alarm",
      "source": "aux:fanTemperature[2]",
      "condition": "GreaterThan",
      "threshold": 80.0,
      "debounceMs": 5000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 우측 블로워 모터 온도 상승 (잠정 80 도, 협의 중)"
    },
    {
      "code": "AL-26",
      "name": "EFEM Side Storage Left Blower Motor Error",
      "severity": "Critical",
      "source": "device:F-4.alarmCode",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "messageKo": "보관부 좌측 블로워 모터 이상 — 알람코드 확인"
    },
    {
      "code": "AL-27",
      "name": "EFEM Side Storage Left Blower Motor Driver Communication Error",
      "severity": "Critical",
      "source": "device:F-4",
      "condition": "CommFail",
      "debounceMs": 1000,
      "resetPolicy": "Auto",
      "messageKo": "보관부 좌측 블로워 드라이버 통신 이상"
    },
    {
      "code": "AL-28",
      "name": "EFEM Side Storage Left Blower Motor Temp Error",
      "severity": "Alarm",
      "source": "aux:fanTemperature[3]",
      "condition": "GreaterThan",
      "threshold": 80.0,
      "debounceMs": 5000,
      "resetPolicy": "Auto",
      "messageKo": "보관부 좌측 블로워 모터 온도 상승 (잠정 80 도, 협의 중)"
    },
    {
      "code": "AL-29",
      "name": "EFEM Side Storage Right Blower Motor Error",
      "severity": "Critical",
      "source": "device:F-5.alarmCode",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "messageKo": "보관부 우측 블로워 모터 이상 — 알람코드 확인"
    },
    {
      "code": "AL-30",
      "name": "EFEM Side Storage Right Blower Motor Driver Communication Error",
      "severity": "Critical",
      "source": "device:F-5",
      "condition": "CommFail",
      "debounceMs": 1000,
      "resetPolicy": "Auto",
      "messageKo": "보관부 우측 블로워 드라이버 통신 이상"
    },
    {
      "code": "AL-31",
      "name": "EFEM Side Storage Right Blower Motor Temp Error",
      "severity": "Alarm",
      "source": "aux:fanTemperature[4]",
      "condition": "GreaterThan",
      "threshold": 80.0,
      "debounceMs": 5000,
      "resetPolicy": "Auto",
