{
  // ESAM 알람 정의 — DESIGN.md 5.1 (총 31종)
  //
  // 알람은 코드가 아니라 데이터다. 임계값 변경이나 알람 추가에 재컴파일이 필요하면
  // 현장에서 손댈 수 없어 결국 아무도 조정하지 않는다.
  //
  // ── source 경로 규약 (SnapshotValueResolver) ──────────────────────────────
  //   device:<ID>.pressurePa        차압 [Pa]        품질이 Good 일 때만 값이 나온다
  //   device:<ID>.rpm               팬 회전수 [RPM]
  //   device:<ID>.positionPercent   밸브 개도 [%]
  //   device:<ID>                   통신 실패 판정용 (CommFail)
  //   deviceGroup:Pressure|Valve|Fan  그룹 단위 통신 실패
  //   aux:temperatureEfem | humidityEfem | particle | temperatureControlBox | ffuRpm
  //   aux:airVelocity[0..2] | fanTemperature[0..4] | mfcFlow[0..1]
  //   plc:di.emo | di.door | di.mainBreaker | di.ctrlBoxFan | di.fanStop[0..4]
  //
  // ── condition ─────────────────────────────────────────────────────────────
  //   GreaterThan / LessThan      threshold 와 비교
  //   OutOfBand                   referenceMode 의 정상 대역 이탈. threshold 를 쓰지 않는다
  //   CommFail                    통신 실패
  //   CommFailOrAlarmCode         통신 실패 또는 장치 알람코드 != 0
  //   BitSet                      PLC 디지털 입력이 1
  //
  // ── severity ──────────────────────────────────────────────────────────────
  //   Info / Warning / Alarm / Critical
  //
  // ── resetPolicy ───────────────────────────────────────────────────────────
  //   Auto    조건이 해소되면 스스로 풀린다
  //   Manual  원인 확인 후 사용자가 Reset 해야 풀린다
  //
  // ── debounceMs ────────────────────────────────────────────────────────────
  // 조건이 이 시간 이상 연속으로 성립해야 발생한다. 0 이면 즉시.
  // 폴링 주기(CH1 Fast 250ms)보다 작은 값은 의미가 없다.
  // 압력 대역 이탈은 제어가 정정할 시간을 줘야 하므로 Config 의 Time 값과 맞춘다.
  "schemaVersion": "1.0",

  "rules": [

    // ══ Pressure P00 — 차압센서 통신 ══════════════════════════════════════════
    {
      // 차압센서가 하나라도 끊기면 그 체인은 제어 불가다.
      // 개별 센서 알람(P10~P14)과 별개로 그룹 단위 조기 경보를 둔다.
      "code": "P00",
      "name": "차압센서 통신 이상",
      "severity": "Critical",
      "source": "deviceGroup:Pressure",
      "condition": "CommFail",
      "debounceMs": 1000,
      "resetPolicy": "Auto",
      "messageKo": "차압센서 통신이 끊겼습니다. 해당 체인의 자동 제어가 중단됩니다."
    },

    // ══ Pressure P01~P05 — Sensor 2 대역 이탈 (제어 기준 센서) ════════════════
    // OutOfBand 는 Config 의 Sensor 2 설정값·대역을 그대로 따른다.
    // 임계값을 여기에 중복해 적으면 Config 화면에서 바꿨을 때 알람만 옛 값으로 남는다.
    {
      "code": "P01", "name": "차압센서 S2-1(EEXCF) 대역 이탈", "severity": "Alarm",
      "source": "device:S2-1.pressurePa", "condition": "OutOfBand", "referenceMode": "Sensor2",
      "debounceMs": 120000, "resetPolicy": "Auto",
      "messageKo": "EC 체인 차압이 설정 대역을 벗어났습니다."
    },
    {
      "code": "P02", "name": "차압센서 S2-2(EEXLF) 대역 이탈", "severity": "Alarm",
      "source": "device:S2-2.pressurePa", "condition": "OutOfBand", "referenceMode": "Sensor2",
      "debounceMs": 120000, "resetPolicy": "Auto",
      "messageKo": "EL 체인 차압이 설정 대역을 벗어났습니다."
    },
    {
      "code": "P03", "name": "차압센서 S2-3(EEXRF) 대역 이탈", "severity": "Alarm",
      "source": "device:S2-3.pressurePa", "condition": "OutOfBand", "referenceMode": "Sensor2",
      "debounceMs": 120000, "resetPolicy": "Auto",
      "messageKo": "ER 체인 차압이 설정 대역을 벗어났습니다."
    },
    {
      "code": "P04", "name": "차압센서 S2-4(EEXSLF) 대역 이탈", "severity": "Alarm",
      "source": "device:S2-4.pressurePa", "condition": "OutOfBand", "referenceMode": "Sensor2",
      "debounceMs": 120000, "resetPolicy": "Auto",
      "messageKo": "SL 체인 차압이 설정 대역을 벗어났습니다."
    },
    {
      "code": "P05", "name": "차압센서 S2-5(EEXSRF) 대역 이탈", "severity": "Alarm",
      "source": "device:S2-5.pressurePa", "condition": "OutOfBand", "referenceMode": "Sensor2",
      "debounceMs": 120000, "resetPolicy": "Auto",
      "messageKo": "SR 체인 차압이 설정 대역을 벗어났습니다."
    },

    // ══ Pressure P06~P09 — Sensor 1 대역 이탈 ════════════════════════════════
    // Sensor 1 은 EC·SL·SR 3곳에만 설치된다(IO List 확인). EL·ER 은 알람 대상이 없다.
    {
      "code": "P06", "name": "차압센서 S1-1(EC) 대역 이탈", "severity": "Warning",
      "source": "device:S1-1.pressurePa", "condition": "OutOfBand", "referenceMode": "Sensor1",
      "debounceMs": 60000, "resetPolicy": "Auto",
      "messageKo": "EFEM 내부 압력이 설정 대역을 벗어났습니다."
    },
    {
      "code": "P07", "name": "차압센서 S1-2(SL) 대역 이탈", "severity": "Warning",
      "source": "device:S1-2.pressurePa", "condition": "OutOfBand", "referenceMode": "Sensor1",
      "debounceMs": 60000, "resetPolicy": "Auto",
      "messageKo": "EFEM 내부 압력이 설정 대역을 벗어났습니다."
    },
    {
      "code": "P08", "name": "차압센서 S1-3(SR) 대역 이탈", "severity": "Warning",
      "source": "device:S1-3.pressurePa", "condition": "OutOfBand", "referenceMode": "Sensor1",
      "debounceMs": 60000, "resetPolicy": "Auto",
      "messageKo": "EFEM 내부 압력이 설정 대역을 벗어났습니다."
    },
    {
      // 배기 상실 조기 경보. 인터록 IL-01(0 Pa)보다 먼저 울려야 의미가 있다.
      // 인터록은 Manual 래치라 걸리면 장비가 멈춘다. 그 전에 알려야 대응할 수 있다.
      "code": "P09", "name": "배기 음압 저하 경고", "severity": "Warning",
      "source": "device:S3-1.pressurePa", "condition": "GreaterThan", "threshold": -100.0,
      "debounceMs": 30000, "resetPolicy": "Auto",
      "messageKo": "배기 덕트 음압이 -100 Pa 위로 올라왔습니다. 계속 상승하면 인터록이 발동합니다."
    },

    // ══ Pressure P10~P14 — Sensor 3 대역 이탈 (배기 라인) ════════════════════
    {
      "code": "P10", "name": "차압센서 S3-1(EEXCB) 대역 이탈", "severity": "Alarm",
      "source": "device:S3-1.pressurePa", "condition": "OutOfBand", "referenceMode": "Sensor3",
      "debounceMs": 300000, "resetPolicy": "Auto",
      "messageKo": "EC 배기 차압이 설정 대역을 벗어났습니다."
    },
    {
      "code": "P11", "name": "차압센서 S3-2(EEXLB) 대역 이탈", "severity": "Alarm",
      "source": "device:S3-2.pressurePa", "condition": "OutOfBand", "referenceMode": "Sensor3",
      "debounceMs": 300000, "resetPolicy": "Auto",
      "messageKo": "EL 배기 차압이 설정 대역을 벗어났습니다."
    },
    {
      "code": "P12", "name": "차압센서 S3-3(EEXRB) 대역 이탈", "severity": "Alarm",
      "source": "device:S3-3.pressurePa", "condition": "OutOfBand", "referenceMode": "Sensor3",
      "debounceMs": 300000, "resetPolicy": "Auto",
      "messageKo": "ER 배기 차압이 설정 대역을 벗어났습니다."
    },
    {
      "code": "P13", "name": "차압센서 S3-4(EEXSLB) 대역 이탈", "severity": "Alarm",
      "source": "device:S3-4.pressurePa", "condition": "OutOfBand", "referenceMode": "Sensor3",
      "debounceMs": 300000, "resetPolicy": "Auto",
      "messageKo": "SL 배기 차압이 설정 대역을 벗어났습니다."
    },
    {
      "code": "P14", "name": "차압센서 S3-5(EEXSRB) 대역 이탈", "severity": "Alarm",
      "source": "device:S3-5.pressurePa", "condition": "OutOfBand", "referenceMode": "Sensor3",
      "debounceMs": 300000, "resetPolicy": "Auto",
      "messageKo": "SR 배기 차압이 설정 대역을 벗어났습니다."
    },

    // ══ Process A01~A05 — 액추에이터 ═════════════════════════════════════════
    {
      // 밸브가 응답하지 않거나 드라이브 알람이 뜨면 제어 수단을 잃는다.
      "code": "A01",
      "name": "스로틀밸브 이상",
      "severity": "Critical",
      "source": "deviceGroup:Valve",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 1000,
      "resetPolicy": "Manual",
      "messageKo": "스로틀밸브 통신 실패 또는 드라이브 알람입니다. 자동 제어를 사용할 수 없습니다."
    },
    {
      "code": "A02",
      "name": "송풍팬 이상",
      "severity": "Critical",
      "source": "deviceGroup:Fan",
      "condition": "CommFailOrAlarmCode",
      "debounceMs": 1000,
      "resetPolicy": "Manual",
      "messageKo": "송풍팬 통신 실패 또는 드라이브 알람입니다."
    },
    {
      // 밸브가 90도까지 열렸는데도 대역에 못 들어오면 배기 능력이 부족하다.
      // 제어 여력 소진을 조기에 알리는 항목이다.
      "code": "A03",
      "name": "스로틀밸브 개도 포화",
      "severity": "Warning",
      "source": "device:V-1.positionPercent",
      "condition": "GreaterThan",
      "threshold": 98.0,
      "debounceMs": 60000,
      "resetPolicy": "Auto",
      "messageKo": "EC 밸브가 완전 개방 상태로 유지되고 있습니다. 배기 능력을 확인하십시오."
    },
    {
      "code": "A04",
      "name": "송풍팬 회전수 상한 도달",
      "severity": "Warning",
      "source": "device:F-1.rpm",
      "condition": "GreaterThan",
      "threshold": 3900.0,
      "debounceMs": 60000,
      "resetPolicy": "Auto",
      "messageKo": "EC 송풍팬이 최대 회전수 부근에서 운전 중입니다. 제어 여력이 거의 없습니다."
    },
    {
      "code": "A05",
      "name": "FFU 이상",
      "severity": "Warning",
      "source": "aux:ffuRpm",
      "condition": "LessThan",
      "threshold": 100.0,
      "debounceMs": 10000,
      "resetPolicy": "Auto",
      "enabled": false,
      "messageKo": "FFU 회전수가 하한 미만입니다. (사양 미확보 — 기본 비활성)"
    },

    // ══ Process A06~A08 — PLC 디지털 입력 ════════════════════════════════════
    {
      // 인터록 IL-02 와 짝을 이룬다. 인터록은 정지시키고, 알람은 이력에 남긴다.
      "code": "A06",
      "name": "비상정지(EMO) 작동",
      "severity": "Critical",
      "source": "plc:di.emo",
      "condition": "BitSet",
      "debounceMs": 0,
      "resetPolicy": "Manual",
      "messageKo": "비상정지 버튼이 눌렸습니다. 원인 확인 후 Reset 하십시오."
    },
    {
      "code": "A07",
      "name": "컨트롤박스 냉각팬 정지",
      "severity": "Alarm",
      "source": "plc:di.ctrlBoxFan",
      "condition": "BitSet",
      "debounceMs": 5000,
      "resetPolicy": "Auto",
      "messageKo": "컨트롤박스 냉각팬(상부 또는 하부)이 정지했습니다."
    },
    {
      "code": "A08",
      "name": "BLDC 냉각팬 정지",
      "severity": "Alarm",
      "source": "plc:di.fanStop[0]",
      "condition": "BitSet",
      "debounceMs": 5000,
      "resetPolicy": "Auto",
      "messageKo": "EC 송풍팬 냉각팬이 정지했습니다."
    },

    // ══ Process A09~A12 — 온습도 / 파티클 ════════════════════════════════════
    {
      "code": "A09",
      "name": "EFEM 온도 상한 초과",
      "severity": "Warning",
      "source": "aux:temperatureEfem",
      "condition": "GreaterThan",
      "threshold": 30.0,
      "debounceMs": 30000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 내부 온도가 30도를 넘었습니다."
    },
    {
      "code": "A10",
      "name": "습도 상한 초과",
      "severity": "Warning",
      "source": "aux:humidityEfem",
      "condition": "GreaterThan",
      "threshold": 60.0,
      "debounceMs": 30000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 습도가 60%를 넘었습니다."
    },
    {
      "code": "A11",
      "name": "습도 하한 미만",
      "severity": "Warning",
      "source": "aux:humidityEfem",
      "condition": "LessThan",
      "threshold": 30.0,
      "debounceMs": 30000,
      "resetPolicy": "Auto",
      "messageKo": "EFEM 습도가 30% 미만입니다."
    },
    {
      "code": "A12",
      "name": "파티클 농도 상한 초과",
      "severity": "Alarm",
      "source": "aux:particle",
      "condition": "GreaterThan",
      "threshold": 1000.0,
      "debounceMs": 10000,
      "resetPolicy": "Auto",
      "enabled": false,
      "messageKo": "파티클 농도가 상한을 넘었습니다. (프로토콜 미확보 — 기본 비활성)"
    },

    // ══ Process A13 — 컨트롤박스 온도 ════════════════════════════════════════
    {
      "code": "A13",
      "name": "컨트롤박스 온도 상한 초과",
      "severity": "Alarm",
      "source": "aux:temperatureControlBox",
      "condition": "GreaterThan",
      "threshold": 45.0,
      "debounceMs": 30000,
      "resetPolicy": "Auto",
      "enabled": false,
      "messageKo": "컨트롤박스 온도가 45도를 넘었습니다. (TC 채널 미배정 — 기본 비활성)"
    },

    // ══ Process A14~A16 — 풍속 ═══════════════════════════════════════════════
    {
      "code": "A14", "name": "풍속 1(EEXCF) 하한 미만", "severity": "Warning",
      "source": "aux:airVelocity[0]", "condition": "LessThan", "threshold": 0.3,
      "debounceMs": 30000, "resetPolicy": "Auto",
      "messageKo": "EEXCF 풍속이 하한 미만입니다. 기류 순환을 확인하십시오."
    },
    {
      "code": "A15", "name": "풍속 2(EEXSLF) 하한 미만", "severity": "Warning",
      "source": "aux:airVelocity[1]", "condition": "LessThan", "threshold": 0.3,
      "debounceMs": 30000, "resetPolicy": "Auto",
      "messageKo": "EEXSLF 풍속이 하한 미만입니다."
    },
    {
      "code": "A16", "name": "풍속 3(EEXSRF) 하한 미만", "severity": "Warning",
      "source": "aux:airVelocity[2]", "condition": "LessThan", "threshold": 0.3,
      "debounceMs": 30000, "resetPolicy": "Auto",
      "messageKo": "EEXSRF 풍속이 하한 미만입니다."
    },

    // ══ Process A17 — BLDC 온도 ══════════════════════════════════════════════
    {
      "code": "A17",
      "name": "송풍팬 BLDC 온도 상한 초과",
      "severity": "Alarm",
      "source": "aux:fanTemperature[0]",
      "condition": "GreaterThan",
      "threshold": 70.0,
      "debounceMs": 30000,
      "resetPolicy": "Auto",
      "messageKo": "EC 송풍팬 BLDC 온도가 70도를 넘었습니다."
    },

    // ══ Process A18~A19 — MFC (사양 미확보) ══════════════════════════════════
    {
      "code": "A18", "name": "MFC 1 유량 이상", "severity": "Warning",
      "source": "aux:mfcFlow[0]", "condition": "LessThan", "threshold": 1.0,
      "debounceMs": 10000, "resetPolicy": "Auto", "enabled": false,
      "messageKo": "MFC 1 유량이 하한 미만입니다. (사양 미확보 — 기본 비활성)"
    },
    {
      "code": "A19", "name": "MFC 2 유량 이상", "severity": "Warning",
      "source": "aux:mfcFlow[1]", "condition": "LessThan", "threshold": 1.0,
      "debounceMs": 10000, "resetPolicy": "Auto", "enabled": false,
      "messageKo": "MFC 2 유량이 하한 미만입니다. (사양 미확보 — 기본 비활성)"
    }
  ]
}
