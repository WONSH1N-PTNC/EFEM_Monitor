{
  // ESAM 운전 파라미터 — ECID 마스터
  //
  // 이 파일에만 압력 임계값 숫자가 있다. alarms.json 은 "어느 센서의 어느 한계를
  // 볼 것인가" 만 지정하고 값을 갖지 않는다. 값을 두 곳에 두면 Config 화면에서
  // 바꿨을 때 알람만 옛 값으로 남아, 화면과 알람이 서로 다른 진실을 말하게 된다.
  //
  // ESAM_IO List_260806.xlsx 의 ECID 시트 39항목 = 센서 13대 × (설정값 + 상한 + 하한).
  // 상위(GEM)가 ECID 로 읽고 쓰는 값이 여기다. 번호 매핑은 gem-map.json 이 담당한다.
  //
  // ── 여기 없는 것 ─────────────────────────────────────────────────────────────
  //   이탈 확정 시간(Time)   모드별 공통이므로 control.json (2026-08-10 확정)
  //   센서 계측 레인지        하드웨어 사양이므로 device-map.json
  //   밸브·팬 파라미터        제어 알고리즘 파라미터이므로 control.json
  //
  // ── 상한과 하한을 독립적으로 둔다 ────────────────────────────────────────────
  // 종전에는 Setpoint ± Band 로 대칭을 강제했다. 배기 계통은 상한 여유와
  // 하한 여유가 다를 수 있으므로 독립적으로 두는 편이 물리적으로 맞다.
  //
  // ── 값의 출처 ────────────────────────────────────────────────────────────────
  // ESAM 운용방법 설명자료 p.6 Config 화면 기본값을 센서별로 펼친 것이다.
  // 현장 튜닝(Phase 5)에서 통로별로 조정한다.
  "schemaVersion": "1.0",
  "name": "기본 레시피",

  "sensors": [

    // ── Sensor 1 — EFEM 내부 압력 (양압 유지) ─────────────────────────────────
    // EC·SL·SR 3곳에만 설치된다. EL·ER 위치에는 센서가 없다(IO List 확인).
    { "deviceId": "S1-1", "setpointPa":    6.0, "lowLimitPa":    4.0, "highLimitPa":    8.0 },
    { "deviceId": "S1-2", "setpointPa":    6.0, "lowLimitPa":    4.0, "highLimitPa":    8.0 },
    { "deviceId": "S1-3", "setpointPa":    6.0, "lowLimitPa":    4.0, "highLimitPa":    8.0 },

    // ── Sensor 2 — 배기 전단 (제어 기준) ──────────────────────────────────────
    // 밸브·팬 직전 차압. 자동 제어의 기본 기준값이다.
    { "deviceId": "S2-1", "setpointPa":  -10.0, "lowLimitPa":  -40.0, "highLimitPa":   20.0 },
    { "deviceId": "S2-2", "setpointPa":  -10.0, "lowLimitPa":  -40.0, "highLimitPa":   20.0 },
    { "deviceId": "S2-3", "setpointPa":  -10.0, "lowLimitPa":  -40.0, "highLimitPa":   20.0 },
    { "deviceId": "S2-4", "setpointPa":  -10.0, "lowLimitPa":  -40.0, "highLimitPa":   20.0 },
    { "deviceId": "S2-5", "setpointPa":  -10.0, "lowLimitPa":  -40.0, "highLimitPa":   20.0 },

    // ── Sensor 3 — 배기 후단 ──────────────────────────────────────────────────
    // 인터록 IL-01 은 이 대역이 아니라 절대값 0 Pa(대기압)를 쓴다.
    // 안전 임계값이 운전 파라미터에 종속되면 Config 조작으로 움직이기 때문이다.
    // 여기 상한 -100 Pa 는 알람(P09 계열)이 쓰는 운전 기준이다.
    { "deviceId": "S3-1", "setpointPa": -200.0, "lowLimitPa": -300.0, "highLimitPa": -100.0 },
    { "deviceId": "S3-2", "setpointPa": -200.0, "lowLimitPa": -300.0, "highLimitPa": -100.0 },
    { "deviceId": "S3-3", "setpointPa": -200.0, "lowLimitPa": -300.0, "highLimitPa": -100.0 },
    { "deviceId": "S3-4", "setpointPa": -200.0, "lowLimitPa": -300.0, "highLimitPa": -100.0 },
    { "deviceId": "S3-5", "setpointPa": -200.0, "lowLimitPa": -300.0, "highLimitPa": -100.0 }
  ]
}
