    </Compile>
    <Compile Include="Controls\ArcGauge.cs" />
    <Compile Include="Controls\TrendChart.cs" />
    <Compile Include="Infrastructure\ObservableObject.cs" />
    <Compile Include="Infrastructure\IWriteAccessProvider.cs" />
