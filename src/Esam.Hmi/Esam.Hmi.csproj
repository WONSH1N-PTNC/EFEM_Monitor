    <Compile Include="ViewModels\IoStatusRowViewModels.cs" />
    <Compile Include="ViewModels\ChainCardViewModel.cs" />
    <Compile Include="ViewModels\GaugeViewModel.cs" />
    <Compile Include="ViewModels\AlarmRowViewModel.cs" />
    <Compile Include="ViewModels\ReadoutViewModel.cs" />
    <Compile Include="ViewModels\DesignTimeData.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      배포 설정 파일을 출력 폴더로 복사한다.
      복사하지 않으면 실행 시 config 폴더를 찾지 못해 기동에 실패한다.
      링크로 두어 원본 한 벌만 유지한다.
    -->
    <None Include="..\..\config\device-map.json">
      <Link>config\device-map.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\config\recipe.json">
      <Link>config\recipe.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\config\alarms.json">
      <Link>config\alarms.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
