<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Esam.Hmi — WPF HMI (Phase 4).

    클래식 csproj 형식을 쓰는 이유:
    net472 를 대상으로 하는 WPF 는 SDK 스타일(<UseWPF>)을 지원하지 않는다.
    UseWPF 는 .NET Core 3.0 이상 전용이므로, .NET Framework WPF 는
    ProjectTypeGuids 와 Microsoft.CSharp.targets 를 직접 지정하는 이 형식이 정답이다.
  -->
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A1000000-0000-4000-8000-000000000004}</ProjectGuid>
    <ProjectTypeGuids>{60dc8134-eba5-43b8-bcc9-bb4bc16c2548};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Esam.Hmi</RootNamespace>
    <AssemblyName>Esam.Hmi</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <ProjectTypeGuidsSuppressWarning>true</ProjectTypeGuidsSuppressWarning>
    <WarningLevel>4</WarningLevel>
    <LangVersion>7.3</LangVersion>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>

    <!--
      XAML 컴파일러가 생성하는 코드에는 XML 문서 주석이 없으므로
      문서 생성과 경고-오류 승격을 이 프로젝트에서는 적용하지 않는다.
      대신 소스 코드 주석 규칙은 그대로 지킨다.
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!--
      ★ NuGet 참조 방식을 PackageReference 로 명시한다.

      클래식 csproj 는 기본이 packages.config 다. 그 상태에서 SDK 스타일
      프로젝트를 ProjectReference 하면 상대의 PackageReference 자산이
      전이되지 않는다. 빌드는 통과하고 실행 시점에 Newtonsoft.Json 을
      찾지 못해 FileNotFoundException 으로 죽는다.

      즉 컴파일러가 잡아주지 못하는 종류의 실패다. 아래 PackageReference 로
      직접 명시해 그 경로를 막는다.
    -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!--
      설정 파일을 읽는 계층(Esam.Communication)이 쓰는 것과 같은 버전이어야 한다.
      다르면 어셈블리 바인딩 리다이렉트에 의존하게 되고, 그것이 어긋나면
      런타임에만 드러난다.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Esam.Domain\Esam.Domain.csproj">
      <Project>{A1000000-0000-4000-8000-000000000001}</Project>
      <Name>Esam.Domain</Name>
    </ProjectReference>
    <ProjectReference Include="..\Esam.Communication\Esam.Communication.csproj">
      <Project>{A1000000-0000-4000-8000-000000000002}</Project>
      <Name>Esam.Communication</Name>
    </ProjectReference>
    <ProjectReference Include="..\Esam.Services\Esam.Services.csproj">
      <Project>{A1000000-0000-4000-8000-000000000003}</Project>
      <Name>Esam.Services</Name>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
