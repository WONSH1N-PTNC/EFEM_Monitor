<UserControl x:Class="Esam.Hmi.Views.IoStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1400" d:DesignHeight="800"
             Background="{StaticResource BgRootBrush}"
             FontFamily="{StaticResource UiFont}">

    <!--
        S6 커미셔닝의 판정 수단이다. 가공하지 않은 것을 함께 보여 준다.
        압력은 환산 전 레지스터와 환산 후 Pa 를, PLC 입력은 설정된 극성과
        현재 판정값을 나란히 놓는다. 둘 중 하나만 보면 어긋난 사실을 알 수 없다.
    -->

    <UserControl.Resources>
        <Style x:Key="IoHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource MicroLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="IoCellStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="IoLabelCellStyle" TargetType="TextBlock" BasedOn="{StaticResource IoCellStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ 머리말 ═════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="I/O STATUS — 연결 상태 · PLC 입력 · 원시값"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="읽기 전용 화면입니다. 값을 바꾸지 않습니다."
                           FontSize="11" Margin="0,4,0,0"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <!--
                스냅샷 나이. 값이 멈춘 화면과 값이 변하지 않는 공정은 구분되지 않는다.
                나이를 적어 두면 그 둘이 갈린다.
            -->
            <TextBlock Grid.Column="1"
                       Text="{Binding SnapshotAge}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="12"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStale}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource StatusBadBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- ══ 상태 램프 12종 ══════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0" Padding="14">
            <StackPanel>
                <TextBlock Text="연결 · 동작 상태" Style="{StaticResource IoHeaderStyle}" />

                <ItemsControl ItemsSource="{Binding Lamps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource InsetBorderStyle}"
                                    Margin="0,0,8,8" Padding="10,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Brush}" />
                                        <TextBlock Text="{Binding Label}"
                                                   Margin="7,0,0,0"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding StateText}"
                                               Margin="16,3,0,0"
                                               FontSize="11"
                                               Foreground="{Binding Brush}" />

                                    <TextBlock Text="{Binding Detail}"
                                               Margin="16,1,0,0"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ══ 표 3종 ═════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <!-- ── PLC 디지털 입력 ────────────────────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,7,0" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="PLC 디지털 입력" Style="{StaticResource IoHeaderStyle}" />

                        <!--
                            극성 판정용이다. 설정된 극성과 현재 판정값을 나란히 본다.
                            판정값만 보면 극성이 뒤집혔는지 배선이 끊겼는지 구분하지 못한다.
                        -->
                        <TextBlock Text="설정 극성과 판정값을 대조해 비트 극성을 확정합니다."
                                   FontSize="10" Margin="0,0,0,8"
                                   Foreground="{StaticResource TextMutedBrush}" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="주소" Style="{StaticResource IoHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="신호" Style="{StaticResource IoHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="극성" Style="{StaticResource IoHeaderStyle}" />
                            <TextBlock Grid.Column="3" Text="판정" Style="{StaticResource IoHeaderStyle}" />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PlcInputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Address}"
                                                   Style="{StaticResource IoLabelCellStyle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Signal}"
                                                   Style="{StaticResource IoCellStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding PolarityText}"
                                                   Style="{StaticResource IoLabelCellStyle}" />
                                        <TextBlock Grid.Column="3" Text="{Binding StateText}"
                                                   Style="{StaticResource IoCellStyle}"
                                                   Foreground="{Binding Brush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── 압력 원시값 + 포트 통계 ───────────────────────────────── -->
            <Grid Grid.Column="1" Margin="7,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="차압센서 원시값" Style="{StaticResource IoHeaderStyle}" />

                            <!--
                                환산값만 보면 10배 틀어져도 그럴듯해 보인다.
                                센서 표시기의 숫자와 레지스터 열을 직접 대조한다.
                            -->
                            <TextBlock Text="레지스터 열을 센서 표시기와 대조해 스케일(Pa/LSB)을 확정합니다."
                                       FontSize="10" Margin="0,0,0,8"
                                       Foreground="{StaticResource TextMutedBrush}" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="센서" Style="{StaticResource IoHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="레지스터" Style="{StaticResource IoHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="환산 [Pa]" Style="{StaticResource IoHeaderStyle}" />
                                <TextBlock Grid.Column="3" Text="보정후 [Pa]" Style="{StaticResource IoHeaderStyle}" />
                                <TextBlock Grid.Column="4" Text="스케일" Style="{StaticResource IoHeaderStyle}" />
                                <TextBlock Grid.Column="5" Text="품질" Style="{StaticResource IoHeaderStyle}" />
                            </Grid>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Pressures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding DeviceId}"
                                                       Style="{StaticResource IoLabelCellStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Register}"
                                                       Style="{StaticResource IoCellStyle}"
                                                       Foreground="{Binding Brush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding RawPa}"
                                                       Style="{StaticResource IoCellStyle}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Pa}"
                                                       Style="{StaticResource IoCellStyle}" />
                                            <TextBlock Grid.Column="4" Text="{Binding ScaleText}"
                                                       Style="{StaticResource IoLabelCellStyle}" />
                                            <TextBlock Grid.Column="5" Text="{Binding QualityText}"
                                                       Style="{StaticResource IoCellStyle}"
                                                       Foreground="{Binding Brush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}"
                        Margin="0,14,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="포트 통신 통계" Style="{StaticResource IoHeaderStyle}" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="포트" Style="{StaticResource IoHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="사이클 [ms]" Style="{StaticResource IoHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="성공률 [%]" Style="{StaticResource IoHeaderStyle}" />
                            <TextBlock Grid.Column="3" Text="타임아웃" Style="{StaticResource IoHeaderStyle}" />
                            <TextBlock Grid.Column="4" Text="CRC" Style="{StaticResource IoHeaderStyle}" />
                            <TextBlock Grid.Column="5" Text="전체" Style="{StaticResource IoHeaderStyle}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Ports}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding PortId}"
                                                   Style="{StaticResource IoLabelCellStyle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CycleMs}"
                                                   Style="{StaticResource IoCellStyle}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SuccessRate}"
                                                   Style="{StaticResource IoCellStyle}"
                                                   Foreground="{Binding Brush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Timeouts}"
                                                   Style="{StaticResource IoCellStyle}" />
                                        <TextBlock Grid.Column="4" Text="{Binding CrcErrors}"
                                                   Style="{StaticResource IoCellStyle}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Total}"
                                                   Style="{StaticResource IoLabelCellStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
