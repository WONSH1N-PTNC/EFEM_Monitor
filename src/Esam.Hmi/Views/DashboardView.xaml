<UserControl x:Class="Esam.Hmi.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:Esam.Hmi.Controls"
             xmlns:vm="clr-namespace:Esam.Hmi.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{x:Static vm:DesignTimeData.Dashboard}"
             d:DesignWidth="1600" d:DesignHeight="900"
             Background="{StaticResource BgRootBrush}"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>

        <!-- 게이지 + 우측 상세 3줄로 이루어진 블록. 센서·밸브·팬이 이 템플릿을 공유한다. -->
        <DataTemplate x:Key="GaugeBlockTemplate">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ctrl:ArcGauge Grid.Column="0"
                               Width="72" Height="72"
                               Margin="4"
                               Ratio="{Binding Ratio}"
                               BandStart="{Binding BandStart}"
                               BandEnd="{Binding BandEnd}"
                               ShowBand="{Binding ShowBand}"
                               ArcBrush="{Binding ArcBrush}"
                               ValueText="{Binding ValueText}"
                               UnitText="{Binding UnitText}"
                               ValueBrush="{Binding ValueBrush}"
                               TrackBrush="{StaticResource GaugeTrackBrush}"
                               BandBrush="{StaticResource GaugeBandBrush}"
                               UnitBrush="{StaticResource TextMutedBrush}"
                               ValueFontSize="21"
                               ValueFontFamily="{StaticResource MonoFont}"
                               StrokeWidth="7" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,6,0">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource ReadoutLabelStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding DetailPrefix}"
                                   Style="{StaticResource MicroLabelStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0" />
                        <TextBlock Text="{Binding DetailValue}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{Binding DetailValueBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Text="{Binding DetailSecondary}"
                               Style="{StaticResource DeviceSubtitleStyle}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 라벨 + 값 + 단위 한 줄 -->
        <DataTemplate x:Key="ReadoutTemplate">
            <Grid Margin="0,0,0,7">
                <TextBlock Text="{Binding Label}"
                           Style="{StaticResource ReadoutLabelStyle}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Value}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{Binding ValueBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Unit}"
                               Style="{StaticResource MicroLabelStyle}"
                               VerticalAlignment="Bottom"
                               Margin="4,0,0,2" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 우측 패널 ACTIVE ALARM 항목 -->
        <DataTemplate x:Key="ActiveAlarmTemplate">
            <Border Background="{Binding RowBackground}" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Column="0" Fill="{Binding AccentBrush}" />

                    <StackPanel Grid.Column="1" Margin="9,7,8,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Code}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{Binding AccentBrush}" />
                            <TextBlock Text="{Binding Time}"
                                       Style="{StaticResource MicroLabelStyle}"
                                       Margin="8,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   Style="{StaticResource ReadoutLabelStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 알람 배너 -->
            <RowDefinition Height="Auto" />
            <!-- 챔버 + 센서 1 -->
            <RowDefinition Height="Auto" />
            <!-- 체인 카드 -->
            <RowDefinition Height="*" />
            <!-- 트렌드 -->
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="248" />
        </Grid.ColumnDefinitions>

        <!-- ══ 상단 바 ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Height="56">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="{Binding BrandName}"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding BrandVersion}"
                               Style="{StaticResource MicroLabelStyle}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- 화면 전환. 현재는 Dashboard 만 구현되어 나머지는 비활성이다. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton Content="Dashboard" Style="{StaticResource NavButtonStyle}" IsChecked="True" />
                    <RadioButton Content="Maintenance" Style="{StaticResource NavButtonStyle}" />
                    <RadioButton Content="Config" Style="{StaticResource NavButtonStyle}" />
                    <RadioButton Content="I / O" Style="{StaticResource NavButtonStyle}" />
                    <RadioButton Content="Data Log" Style="{StaticResource NavButtonStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,20,0">
                    <Ellipse Style="{StaticResource StatusDotStyle}" Fill="{StaticResource StatusOkBrush}" />
                    <TextBlock Text="EQUIP" Style="{StaticResource MicroLabelStyle}"
                               VerticalAlignment="Center" Margin="6,0,4,0" />
                    <TextBlock Text="{Binding EquipmentState}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource StatusOkBrush}" VerticalAlignment="Center" />

                    <Ellipse Style="{StaticResource StatusDotStyle}"
                             Fill="{StaticResource StatusOkBrush}" Margin="18,0,0,0" />
                    <TextBlock Text="HOST" Style="{StaticResource MicroLabelStyle}"
                               VerticalAlignment="Center" Margin="6,0,4,0" />
                    <TextBlock Text="{Binding HostState}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource StatusOkBrush}" VerticalAlignment="Center" />

                    <Border Background="{StaticResource AlarmRowBadBrush}"
                            BorderBrush="{StaticResource BorderAlarmBrush}" BorderThickness="1"
                            Margin="18,0,0,0" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDotStyle}"
                                     Fill="{Binding AlarmCounterBrush}" />
                            <TextBlock Text="{Binding AlarmCounterText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{Binding AlarmCounterBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Clock}"
                               Style="{StaticResource MicroLabelStyle}"
                               VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 알람 배너 ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{StaticResource AlarmRowBadBrush}"
                BorderBrush="{Binding BannerBorderBrush}"
                BorderThickness="3,0,0,1"
                Height="48" Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="14,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource StatusDotStyle}" Fill="{Binding BannerBrush}" />
                        <TextBlock Text="{Binding BannerTitle}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{Binding BannerBrush}"
                                   Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding BannerSubtitle}"
                               Style="{StaticResource MicroLabelStyle}"
                               Margin="14,2,0,0" />
                </StackPanel>

                <!-- 알람 3건을 한 줄에 나열한다. 배너 하나로 전체 상황을 파악하게 하는 것이 목적이다. -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding TickerAlarms}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,26,0">
                                <TextBlock Text="{Binding Code}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{Binding AccentBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource ReadoutLabelStyle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Time}"
                                           Style="{StaticResource MicroLabelStyle}"
                                           VerticalAlignment="Center" Margin="10,1,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Grid.Column="2" Content="ACK ALL"
                        Style="{StaticResource ConsoleButtonStyle}"
                        Command="{Binding AckAllCommand}"
                        Margin="0,0,0,0" />
            </Grid>
        </Border>

        <!-- ══ 챔버 + 센서 1 ════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="216" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="{Binding EquipmentName}"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding EquipmentSubtitle}"
                               Style="{StaticResource MicroLabelStyle}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Style="{StaticResource StatusDotStyle}"
                                 Fill="{StaticResource StatusOkBrush}" />
                        <TextBlock Text="{Binding FfuStatus}"
                                   Style="{StaticResource MicroLabelStyle}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- 센서 1 게이지 3개. EFEM 내부 압력은 제어 모드와 무관하게 항상 표시한다. -->
                <ContentPresenter Grid.Column="1" Content="{Binding Sensor1Gauges[0]}"
                                  ContentTemplate="{StaticResource GaugeBlockTemplate}" />
                <ContentPresenter Grid.Column="2" Content="{Binding Sensor1Gauges[1]}"
                                  ContentTemplate="{StaticResource GaugeBlockTemplate}" />
                <ContentPresenter Grid.Column="3" Content="{Binding Sensor1Gauges[2]}"
                                  ContentTemplate="{StaticResource GaugeBlockTemplate}" />

                <Border Grid.Column="4" Style="{StaticResource InsetBorderStyle}"
                        Margin="12,0,20,0" Padding="14,10">
                    <ItemsControl ItemsSource="{Binding ChamberReadouts}"
                                  ItemTemplate="{StaticResource ReadoutTemplate}" />
                </Border>
            </Grid>
        </Border>

        <!-- ══ 체인 카드 5열 ════════════════════════════════════════════════════ -->
        <ItemsControl Grid.Row="3" Grid.Column="0"
                      ItemsSource="{Binding Chains}"
                      Margin="10,10,4,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="4,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 상단 강조선. 상태색과 같아 멀리서도 이상 체인이 눈에 띈다. -->
                            <Rectangle Grid.Row="0" Fill="{Binding AccentBrush}" />

                            <Grid Grid.Row="1" Margin="12,9,12,7">
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource SectionTitleStyle}"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding StatusText}"
                                           Style="{StaticResource StatusBadgeStyle}"
                                           Foreground="{Binding StatusBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="6,0,6,4">
                                <ContentPresenter Content="{Binding Sensor}"
                                                  ContentTemplate="{StaticResource GaugeBlockTemplate}" />

                                <TextBlock Text="│ AIRFLOW"
                                           Style="{StaticResource MicroLabelStyle}"
                                           Margin="8,2,0,2" />

                                <ContentPresenter Content="{Binding Valve}"
                                                  ContentTemplate="{StaticResource GaugeBlockTemplate}" />

                                <TextBlock Text="│ EXHAUST"
                                           Style="{StaticResource MicroLabelStyle}"
                                           Margin="8,2,0,2" />

                                <ContentPresenter Content="{Binding Fan}"
                                                  ContentTemplate="{StaticResource GaugeBlockTemplate}" />
                            </StackPanel>

                            <!-- 체인별 알람 바. 어느 체인의 문제인지 즉시 좁혀 준다. -->
                            <Border Grid.Row="3" Background="{Binding AlarmBackground}"
                                    Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{Binding AlarmDot}" />
                                    <TextBlock Text="{Binding AlarmCode}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding AlarmForeground}"
                                               VerticalAlignment="Center" Margin="7,0,0,0" />
                                    <TextBlock Text="{Binding AlarmText}"
                                               FontFamily="{StaticResource UiFont}" FontSize="10"
                                               Foreground="{Binding AlarmForeground}"
                                               VerticalAlignment="Center" Margin="7,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ══ 트렌드 ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Grid.Column="0"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,8,14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TREND"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TrendCaption}"
                                   Style="{StaticResource ReadoutLabelStyle}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <!-- 범례. 색 순서가 체인 번호와 일치해야 한다. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="│ ALARM EVENT"
                                   FontFamily="{StaticResource MonoFont}" FontSize="9"
                                   Foreground="{StaticResource StatusBadBrush}"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <ItemsControl ItemsSource="{Binding TrendSeriesList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Rectangle Width="14" Height="2" VerticalAlignment="Center"
                                                   Fill="{Binding Stroke}" />
                                        <TextBlock Text="{Binding Label}"
                                                   Style="{StaticResource MicroLabelStyle}"
                                                   VerticalAlignment="Center" Margin="5,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <ctrl:TrendChart Grid.Row="1"
                                 Series="{Binding TrendSeriesList}"
                                 Markers="{Binding TrendMarkers}"
                                 Minimum="{Binding TrendMinimum}"
                                 Maximum="{Binding TrendMaximum}"
                                 BandLow="{Binding TrendBandLow}"
                                 BandHigh="{Binding TrendBandHigh}"
                                 Setpoint="{Binding TrendSetpoint}"
                                 Decimals="{Binding TrendDecimals}"
                                 Revision="{Binding TrendRevision}"
                                 BandBrush="{StaticResource GaugeBandBrush}"
                                 GridBrush="{StaticResource GridLineBrush}"
                                 AxisBrush="{StaticResource TextMutedBrush}"
                                 PlotBackground="{StaticResource BgTrendBrush}" />
            </Grid>
        </Border>

        <!-- ══ 우측 패널 ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.RowSpan="4" Grid.Column="1"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,12,14,14">

                    <!-- 제어 -->
                    <TextBlock Text="CONTROL"
                               Style="{StaticResource MicroLabelStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8" />

                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <RadioButton Content="Sensor 1" GroupName="ModeGroup"
                                     IsChecked="{Binding IsSensor1, Mode=OneWay}"
                                     Command="{Binding SelectModeCommand}" CommandParameter="Sensor1"
                                     Style="{StaticResource CompactNavButtonStyle}" Height="30" />
                        <RadioButton Content="Sensor 2" GroupName="ModeGroup"
                                     IsChecked="{Binding IsSensor2, Mode=OneWay}"
                                     Command="{Binding SelectModeCommand}" CommandParameter="Sensor2"
                                     Style="{StaticResource CompactNavButtonStyle}" Height="30" />
                        <RadioButton Content="Sensor 3" GroupName="ModeGroup"
                                     IsChecked="{Binding IsSensor3, Mode=OneWay}"
                                     Command="{Binding SelectModeCommand}" CommandParameter="Sensor3"
                                     Style="{StaticResource CompactNavButtonStyle}" Height="30" />
                    </UniformGrid>

                    <Border Style="{StaticResource InsetBorderStyle}" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="PHASE" Style="{StaticResource MicroLabelStyle}" />
                            <TextBlock Text="AutoControl"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 통신 진단. 100ms 목표 달성 여부를 현장에서 판정하는 근거다. -->
                    <TextBlock Text="포트 사이클 (실측)"
                               Style="{StaticResource MicroLabelStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding PortDiagnostics}"
                                  ItemTemplate="{StaticResource ReadoutTemplate}"
                                  Margin="0,0,0,10" />

                    <!-- 보조 상태 -->
                    <TextBlock Text="보조 상태"
                               Style="{StaticResource MicroLabelStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,8" />
                    <ItemsControl ItemsSource="{Binding AuxiliaryReadouts}"
                                  ItemTemplate="{StaticResource ReadoutTemplate}"
                                  Margin="0,0,0,10" />

                    <!-- 활성 알람 -->
                    <TextBlock Text="ACTIVE ALARM"
                               Style="{StaticResource MicroLabelStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,8" />
                    <ItemsControl ItemsSource="{Binding ActiveAlarms}"
                                  ItemTemplate="{StaticResource ActiveAlarmTemplate}" />

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>
