<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ESAM 다크 콘솔 팔레트.
        디자인 원안(EFEM 대시보드)의 색상값을 그대로 옮겼다.
        반도체 클린룸 조명 아래 장시간 감시하는 화면이므로,
        배경은 충분히 어둡게 하고 상태색만 채도를 높여 시인성을 확보한다.
    -->

    <!-- ── 배경 계층 ────────────────────────────────────────────────────────── -->
    <Color x:Key="BgRootColor">#FF07090C</Color>
    <Color x:Key="BgPanelColor">#FF0B1015</Color>
    <Color x:Key="BgCardColor">#FF0D141B</Color>
    <Color x:Key="BgInsetColor">#FF08131A</Color>
    <Color x:Key="BgRaisedColor">#FF131B23</Color>
    <Color x:Key="BgTrendColor">#FF111A22</Color>

    <SolidColorBrush x:Key="BgRootBrush" Color="{StaticResource BgRootColor}" />
    <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgInsetBrush" Color="{StaticResource BgInsetColor}" />
    <SolidColorBrush x:Key="BgRaisedBrush" Color="{StaticResource BgRaisedColor}" />
    <SolidColorBrush x:Key="BgTrendBrush" Color="{StaticResource BgTrendColor}" />

    <!-- ── 테두리 / 구분선 ──────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BorderBrush" Color="#FF1E2831" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FF16202A" />
    <SolidColorBrush x:Key="BorderAlarmBrush" Color="#FF5D2226" />
    <SolidColorBrush x:Key="BorderWarnBrush" Color="#FF241D10" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#FF2B3B4A" />

    <!-- ── 텍스트 ───────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE9F2F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF8FA3B4" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF5D6D7C" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#FF54677A" />

    <!-- ── 상태색 ───────────────────────────────────────────────────────────── -->
    <!-- 정상. 대역 안이라는 뜻이며 게이지 아크와 상태 배지에 함께 쓴다. -->
    <Color x:Key="StatusOkColor">#FF3ECF8E</Color>
    <!-- 이탈 진행 중. 아직 확정 알람은 아니다. -->
    <Color x:Key="StatusWarnColor">#FFFFB020</Color>
    <!-- 대역 이탈 확정. -->
    <Color x:Key="StatusBadColor">#FFFF5F56</Color>
    <!-- 액추에이터(밸브)용 강조색. 계측값과 구분하기 위해 청록을 쓴다. -->
    <Color x:Key="AccentColor">#FF4CC9F0</Color>

    <SolidColorBrush x:Key="StatusOkBrush" Color="{StaticResource StatusOkColor}" />
    <SolidColorBrush x:Key="StatusWarnBrush" Color="{StaticResource StatusWarnColor}" />
    <SolidColorBrush x:Key="StatusBadBrush" Color="{StaticResource StatusBadColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="StatusOkSoftBrush" Color="#FF5FD39A" />
    <SolidColorBrush x:Key="StatusBadSoftBrush" Color="#FFFF8B84" />
    <SolidColorBrush x:Key="StatusWarnSoftBrush" Color="#FFFFC266" />

    <!-- 알람 행 배경 -->
    <SolidColorBrush x:Key="AlarmRowBadBrush" Color="#FF251416" />
    <SolidColorBrush x:Key="AlarmRowWarnBrush" Color="#FF241D10" />
    <SolidColorBrush x:Key="AlarmRowIdleBrush" Color="#FF111A22" />
    <SolidColorBrush x:Key="AlarmDotIdleBrush" Color="#FF2B3B4A" />

    <!-- ── 체인별 트렌드 라인색 (5개 체인) ──────────────────────────────────── -->
    <!-- 색상 순서는 디자인 원안과 동일하게 유지해야 범례가 일치한다. -->
    <SolidColorBrush x:Key="Chain1Brush" Color="#FF4CC9F0" />
    <SolidColorBrush x:Key="Chain2Brush" Color="#FF5FD39A" />
    <SolidColorBrush x:Key="Chain3Brush" Color="#FFF2C14E" />
    <SolidColorBrush x:Key="Chain4Brush" Color="#FFF2865E" />
    <SolidColorBrush x:Key="Chain5Brush" Color="#FFB58CF0" />

    <!-- 게이지 트랙(빈 구간) -->
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#FF1B2530" />
    <!-- 게이지 정상대역 음영 아크 -->
    <SolidColorBrush x:Key="GaugeBandBrush" Color="#332F9E6E" />

</ResourceDictionary>
