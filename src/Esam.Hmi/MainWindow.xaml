<Window x:Class="Esam.Hmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Esam.Hmi.Views"
        Title="ESAM — EFEM Smart Airflow and Pressure Management System"
        Width="1600" Height="900"
        MinWidth="1280" MinHeight="820"
        Background="{StaticResource BgRootBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!--
        TextFormattingMode=Display 와 UseLayoutRounding 을 켜는 이유:
        다크 배경에 작은 모노스페이스 숫자를 많이 쓰는 화면이라
        서브픽셀 렌더링이 켜져 있으면 글자가 번져 판독성이 떨어진다.
    -->
    <DockPanel LastChildFill="True">

        <!--
            배너를 최하단에 도킹한다.

            상태 표시줄 자리라 대시보드 상단의 장비 상태·알람 티커와 경쟁하지 않는다.
            상단에 두면 화면이 열릴 때 대시보드 전체가 아래로 밀려 배치가 흔들린다.

            중요한 것은 자리보다 <b>항상 보인다</b>는 점이다. 스크롤 밖으로 나가거나
            탭 안쪽에 숨지 않는다. 안전 기능이 동작하지 않는 사실을 감추면 아무도 보지 않는다.
        -->
        <views:SystemBannerView x:Name="Banner" DockPanel.Dock="Bottom" />

        <views:DashboardView x:Name="Dashboard" />
    </DockPanel>
</Window>
