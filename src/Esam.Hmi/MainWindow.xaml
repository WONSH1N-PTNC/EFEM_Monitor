<Window x:Class="Esam.Hmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Esam.Hmi.Views"
        Title="ESAM — EFEM Smart Airflow and Pressure Management System"
        Width="1600" Height="900"
        MinWidth="1280" MinHeight="820"
        Background="{StaticResource BgRootBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!--
        TextFormattingMode=Display 와 UseLayoutRounding 을 켜는 이유:
        다크 배경에 작은 모노스페이스 숫자를 많이 쓰는 화면이라
        서브픽셀 렌더링이 켜져 있으면 글자가 번져 판독성이 떨어진다.
    -->

    <DockPanel LastChildFill="True">

        <!--
            배너를 최하단에 도킹한다.

            상태 표시줄 자리라 대시보드 상단의 장비 상태·알람 티커와 경쟁하지 않는다.
            중요한 것은 자리가 아니라 항상 보인다는 점이다.
            화면을 전환해도 계속 보이도록 셸 바깥에 둔다.
        -->
        <views:SystemBannerView DockPanel.Dock="Bottom"
                                DataContext="{Binding Banner}" />

        <!-- ══ 좌측 사이드바 ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Left"
                Width="132"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <!--
                대시보드 좌상단의 브랜드 라벨을 누르면 접힌다.
                Collapsed 는 자리를 차지하지 않으므로 화면이 그만큼 넓어진다.
            -->
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel LastChildFill="False">

                <StackPanel DockPanel.Dock="Top" Margin="10,14,10,0">
                    <TextBlock Text="ESAM"
                               FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="AIRFLOW CONTROL"
                               Style="{StaticResource MicroLabelStyle}"
                               Margin="0,2,0,16" />

                    <RadioButton Content="Operate" GroupName="ScreenGroup"
                                 IsChecked="{Binding IsOperate, Mode=OneWay}"
                                 Command="{Binding SelectScreenCommand}"
                                 CommandParameter="Operate"
                                 Style="{StaticResource NavButtonStyle}"
                                 Margin="0,0,0,6" />

                    <RadioButton Content="Recipe" GroupName="ScreenGroup"
                                 IsChecked="{Binding IsConfigRecipe, Mode=OneWay}"
                                 Command="{Binding SelectScreenCommand}"
                                 CommandParameter="ConfigRecipe"
                                 Style="{StaticResource NavButtonStyle}"
                                 Margin="0,0,0,6" />

                    <RadioButton Content="Settings" GroupName="ScreenGroup"
                                 IsChecked="{Binding IsConfigSystem, Mode=OneWay}"
                                 Command="{Binding SelectScreenCommand}"
                                 CommandParameter="ConfigSystem"
                                 Style="{StaticResource NavButtonStyle}"
                                 Margin="0,0,0,6" />

                    <RadioButton Content="Maint." GroupName="ScreenGroup"
                                 IsChecked="{Binding IsMaintenance, Mode=OneWay}"
                                 Command="{Binding SelectScreenCommand}"
                                 CommandParameter="Maintenance"
                                 Style="{StaticResource NavButtonStyle}"
                                 Margin="0,0,0,6" />

                    <RadioButton Content="Alarm" GroupName="ScreenGroup"
                                 IsChecked="{Binding IsConfigAlarm, Mode=OneWay}"
                                 Command="{Binding SelectScreenCommand}"
                                 CommandParameter="ConfigAlarm"
                                 Style="{StaticResource NavButtonStyle}"
                                 Margin="0,0,0,6" />

                    <RadioButton Content="I/O" GroupName="ScreenGroup"
                                 IsChecked="{Binding IsIoStatus, Mode=OneWay}"
                                 Command="{Binding SelectScreenCommand}"
                                 CommandParameter="IoStatus"
                                 Style="{StaticResource NavButtonStyle}" />
                </StackPanel>

                <!--
                    쓰기 잠금은 사이드바 맨 아래에 둔다. UI 설명서의 Login 자리와 같다.
                    S9 에서 계정이 들어오면 이 자리를 로그인 창이 대신한다.

                    버튼 문구는 현재 상태가 아니라 누르면 무엇이 되는지를 적는다.
                    상태를 적으면 "지금 잠겨 있다" 인지 "누르면 잠긴다" 인지 헷갈린다.
                -->
                <Button DockPanel.Dock="Bottom"
                        Content="{Binding WriteAccessText}"
                        Command="{Binding ToggleWriteAccessCommand}"
                        Style="{StaticResource ConsoleButtonStyle}"
                        Margin="10,0,10,14"
                        Padding="8,7"
                        FontSize="11" />
            </DockPanel>
        </Border>

        <!--
            ══ 접힌 상태의 복구 띠 ═════════════════════════════════════════════

            ★ 이 띠가 없으면 메뉴를 되돌릴 수 없다.

            접기 버튼(브랜드 라벨)은 Operate 화면에만 있다. Settings·Alarm·I/O
            화면에서 접으면 라벨이 화면에 없어 다시 펼칠 방법이 사라지고,
            프로그램을 재시작해야 한다. D23(Fault 갇힘)과 같은 종류의 문제다.

            그래서 접은 뒤에도 14px 폭의 띠를 남긴다. 어느 화면에서 접었든
            같은 자리에서 되돌릴 수 있다.
        -->
        <Border DockPanel.Dock="Left"
                Width="14"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarVisible}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Button Command="{Binding ToggleSidebarCommand}"
                    ToolTip="좌측 메뉴 펼치기"
                    Cursor="Hand"
                    Content="▸"
                    FontSize="10"
                    Foreground="{StaticResource TextMutedBrush}">
                <Button.Template>
                    <!--
                        띠 전체가 눌려야 한다. 배경 없는 ContentPresenter 만 두면
                        글자 크기(10px)만큼만 눌려서 조준이 어렵다.
                    -->
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>

        <!-- ══ 화면 ═══════════════════════════════════════════════════════════ -->
        <Grid>
            <!--
                화면 인스턴스는 살려 두고 가시성만 바꾼다.
                전환할 때마다 새로 만들면 트렌드 이력이 초기화되고
                편집 중이던 레시피 값이 사라진다.
            -->
            <views:DashboardView DataContext="{Binding Dashboard}">
                <views:DashboardView.Style>
                    <Style TargetType="views:DashboardView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsOperate,
                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:DashboardView.Style>
            </views:DashboardView>

            <views:RecipeEditorView DataContext="{Binding Recipe}">
                <views:RecipeEditorView.Style>
                    <Style TargetType="views:RecipeEditorView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsConfigRecipe,
                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:RecipeEditorView.Style>
            </views:RecipeEditorView>

            <views:MaintenanceView DataContext="{Binding Maintenance}">
                <views:MaintenanceView.Style>
                    <Style TargetType="views:MaintenanceView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsMaintenance,
                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:MaintenanceView.Style>
            </views:MaintenanceView>

            <views:AlarmEditorView DataContext="{Binding Alarms}">
                <views:AlarmEditorView.Style>
                    <Style TargetType="views:AlarmEditorView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsConfigAlarm,
                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:AlarmEditorView.Style>
            </views:AlarmEditorView>

            <views:IoStatusView DataContext="{Binding IoStatus}">
                <views:IoStatusView.Style>
                    <Style TargetType="views:IoStatusView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsIoStatus,
                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:IoStatusView.Style>
            </views:IoStatusView>

            <views:SettingsView DataContext="{Binding Settings}">
                <views:SettingsView.Style>
                    <Style TargetType="views:SettingsView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsConfigSystem,
                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SettingsView.Style>
            </views:SettingsView>
        </Grid>
    </DockPanel>
</Window>
