<Window x:Class="Esam.Hmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Esam.Hmi.Views"
        Title="ESAM — EFEM Smart Airflow and Pressure Management System"
        Width="1600" Height="900"
        MinWidth="1280" MinHeight="820"
        Background="{StaticResource BgRootBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!--
        TextFormattingMode=Display 와 UseLayoutRounding 을 켜는 이유:
        다크 배경에 작은 모노스페이스 숫자를 많이 쓰는 화면이라
        서브픽셀 렌더링이 켜져 있으면 글자가 번져 판독성이 떨어진다.
    -->
    <DockPanel LastChildFill="True">

        <!--
            배너를 최상단에 도킹한다. 스크롤되지 않고 항상 보이는 자리여야 한다.
            안전 기능이 동작하지 않는 사실을 탭 안쪽에 숨기면 아무도 보지 않는다.
        -->
        <views:SystemBannerView x:Name="Banner" DockPanel.Dock="Top" />

        <views:DashboardView x:Name="Dashboard" />
    </DockPanel>
</Window>
