<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Esam.Tests — 도메인 계층 단위테스트.
    Domain 이 하드웨어에 의존하지 않으므로 실장비 없이 제어 알고리즘 전량을 검증할 수 있다.
  -->
  <PropertyGroup>
    <AssemblyName>Esam.Tests</AssemblyName>
    <RootNamespace>Esam.Tests</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- 테스트 코드에는 XML 문서 주석을 강제하지 않는다 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      실제 배포되는 설정 파일을 테스트 출력에 복사한다.
      샘플을 따로 만들어 검증하면 배포본이 깨져도 테스트는 통과한다.
    -->
    <None Include="..\..\config\alarms.json" Link="config\alarms.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\config\device-map.json" Link="config\device-map.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\config\recipe.json" Link="config\recipe.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Esam.Domain\Esam.Domain.csproj" />
    <ProjectReference Include="..\Esam.Communication\Esam.Communication.csproj" />
    <ProjectReference Include="..\Esam.Services\Esam.Services.csproj" />

    <!--
      ★ ViewModel 을 테스트하기 위해 HMI 를 참조한다.

      화면 코드를 테스트에서 참조하는 것이 일반적이지는 않다. 그래도 넣는 이유는,
      이 프로젝트의 ViewModel 이 단순 표시 로직이 아니라 판단을 들고 있기 때문이다.
      입력 문자열 파싱, 쓰기 잠금 관문, 저장 전 검증 경유가 모두 여기에 있다.
      셋 다 틀렸을 때 조용히 잘못된 설정값으로 운전에 들어가는 종류의 결함이다.

      Window·UserControl 은 테스트하지 않는다. ViewModel 만 대상으로 한다.
    -->
    <ProjectReference Include="..\Esam.Hmi\Esam.Hmi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ★ WPF 어셈블리를 명시적으로 참조한다.

      Esam.Hmi 는 net472 WPF 라 클래식 csproj 형식이고, SDK 스타일 프로젝트에는
      net472 용 <UseWPF> 가 없다(.NET Core 3.0 이상 전용).
      즉 이 참조가 없으면 ICommand·CommandManager 를 해석하지 못해
      ViewModel 을 다루는 코드가 컴파일되지 않는다.

      System.Xaml 은 직접 쓰지 않지만 PresentationFramework 가 요구한다.

      System.Xml 등 net472 기본 어셈블리는 SDK 가 이미 넣으므로 적지 않는다.
      중복으로 적으면 항목이 두 번 들어가 경고가 난다.
    -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

</Project>
