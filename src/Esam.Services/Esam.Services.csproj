<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Esam.Services — 응용 서비스 계층.

    의존 방향(DESIGN.md 9.1): Services → Domain, Services → Communication.
    Hmi 는 Services 를 참조하지만 그 역방향은 없다.
    이 계층이 통신과 제어를 잇는 유일한 지점이므로, 스레드 경계도 여기서 정의된다.
  -->
  <PropertyGroup>
    <AssemblyName>Esam.Services</AssemblyName>
    <RootNamespace>Esam.Services</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Esam.Domain\Esam.Domain.csproj" />
    <ProjectReference Include="..\Esam.Communication\Esam.Communication.csproj" />
  </ItemGroup>

</Project>
